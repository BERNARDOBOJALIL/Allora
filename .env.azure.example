# Values used by infra/azure/deploy.sh. Copy only the ones you need into your shell.

APP_NAME_PREFIX=allora
AZURE_LOCATION=eastus
AZURE_RESOURCE_GROUP=rg-allora-dev

# Optional overrides. Names for ACR, Cosmos DB and Redis must be globally unique.
# AZURE_ACR_NAME=alloraacr12345678
# AZURE_COSMOS_ACCOUNT_NAME=allora-mongo-12345678
# AZURE_REDIS_NAME=allora-redis-12345678

# Container App names. Defaults match the service discovery names used by the gateway.
AUTH_APP_NAME=auth-service
CHAT_APP_NAME=chat-service
GATEWAY_APP_NAME=api-gateway

MONGO_DB_NAME=allora_auth
CHAT_MONGO_DB_NAME=allora_chat
CHAT_EVENTS_EXCHANGE=allora.chat.events

# Defaults are dev-friendly. Increase for production.
AUTH_MIN_REPLICAS=1
AUTH_MAX_REPLICAS=3
GATEWAY_MIN_REPLICAS=1
GATEWAY_MAX_REPLICAS=3

# Chat is kept at 1 replica because RabbitMQ runs as a sidecar in the same Container App.
# Use an external RabbitMQ provider before scaling chat horizontally.
CHAT_MIN_REPLICAS=1
CHAT_MAX_REPLICAS=1

# Optional: provide existing PEM files. If omitted, the deploy script generates them.
# JWT_PRIVATE_KEY_FILE=infra/azure/generated/jwt-private.pem
# JWT_PUBLIC_KEY_FILE=infra/azure/generated/jwt-public.pem
